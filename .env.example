# Copy this file to ".env" and fill it in. The only thing you MUST set is an LLM key.

# --- LLM (the brain). Groq is free + fast and supports tool-use. ---
# Get a free key at https://console.groq.com  then paste it below.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
LLM_MODEL=openai/gpt-oss-20b
# (alternatives: llama-3.3-70b-versatile on Groq, or OpenAI gpt-4o-mini with that base_url/key)

# --- OPTIONAL: vision, so you can diagnose from a PHOTO (--image). ---
# Leave blank to skip vision. Set to a vision-capable model your provider offers,
# e.g. a current Groq vision model, or (with OpenAI base_url/key) gpt-4o-mini.
VISION_MODEL=
